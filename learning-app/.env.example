NEXT_PUBLIC_SUPABASE_URL=
# Optional coordinated domain cutover. Leave unset for the existing learn host.
# NEXT_PUBLIC_LEARNING_SITE_URL=https://www.growvelt.com
# NEXT_PUBLIC_CAREERS_SITE_URL=https://jobs.growvelt.com
# NEXT_PUBLIC_LEARNING_DOMAIN_CUTOVER_ENABLED=true
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Identity Services Web OAuth client ID (public; never put the client secret here).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Email Center preparation only. These values do not enable sending.
# Separate Learning keys in the SAME Resend team still share quota/suppressions.
RESEND_MARKETING_API_KEY=
# Plain verified-domain mailbox addresses, not credentials or operator logins.
LEARNING_FROM_EMAIL=
SUPPORT_FROM_EMAIL=
ADMIN_FROM_EMAIL=
PARTNERSHIPS_FROM_EMAIL=partnership@growvelt.com
NOREPLY_FROM_EMAIL=
# Empty General reserved/renamed Growvelt Learning with owner approval, 22 Oct 2026.
# Configuration reference only; no contacts or sending activation implied.
RESEND_LEARNING_SEGMENT_ID=f0815500-6d8a-4662-857f-eaec9d4e0971
RESEND_LEARNING_TOPIC_ID=
# Disabled by default. Set only after approved release + exact test recipients.
# These are SERVER ONLY. A test allowlist never overrides marketing consent.
LEARNING_EMAIL_CENTER_RELEASE=disabled
# Recovery/cancellation can remain available with new sending disabled.
LEARNING_EMAIL_CENTER_RECOVERY=disabled
LEARNING_EMAIL_CENTER_TEST_RECIPIENTS=
LEARNING_EMAIL_VERIFIED_DOMAINS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test-only compatibility key. Prefer PAYSTACK_TEST_SECRET_KEY for new test environments.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
# Comma-separated learner emails allowed to use private Company Test Mode subscription checkout.
# Keep this configured only in a controlled Test Mode environment; leave blank otherwise.
GROWVELT_LEARNING_SUBSCRIPTION_TEST_LEARNER_EMAILS=
# Do not add a live key until the separately approved live activation procedure.
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_MODE=test
PAYMENTS_CHECKOUT_ENABLED=false
PAYMENTS_LIVE_LEARNER_CHECKOUT_ENABLED=false
PAYMENTS_REFUNDS_ENABLED=false
PAYMENTS_LIVE_COMPANY_SETTLEMENT_RECORDING_ENABLED=false
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/paystack/callback
