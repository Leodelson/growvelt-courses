{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/"
      }
    },
    {
      "src": "^/courses(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/learn"
      }
    },
    {
      "src": "^/aboutus(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/about"
      }
    },
    {
      "src": "^/partnerwithus(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/partner-with-growvelt"
      }
    },
    {
      "src": "^/contact(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/contact"
      }
    },
    {
      "src": "^/registration(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/sign-up"
      }
    },
    {
      "src": "^/auth(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/sign-in"
      }
    },
    {
      "src": "^/blog(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/blog"
      }
    },
    {
      "src": "^/privacy-policy(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/privacy-policy"
      }
    },
    {
      "src": "^/terms-of-service(?:\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "https://learn.growvelt.com/terms-of-service"
      }
    },
    {
      "src": "/.*",
      "status": 410
    }
  ]
}
